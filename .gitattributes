# Normalize line endings: LF in the repository, native in the working tree.
# The team develops on Windows while CI runs on Linux; without this, every
# checkout produces spurious whole-file diffs.
* text=auto eol=lf

# Windows-only tooling that must keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets — never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.tif  binary
*.tiff binary
*.webp binary
*.pdf  binary
*.pt   binary
*.pth  binary
*.onnx binary
*.tflite binary
*.safetensors binary
